{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@core/*": ["../core/*"],

      /* FSD frontend Webview */
      "@app/*": ["./src/app/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },

  "include": ["src/**/*", "declarations.d.ts", "../../src/core/**/*"],
  "exclude": ["node_modules"]
}
